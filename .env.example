# Copy to .env locally. Never put real values in this template.
NEBIUS_API_KEY=NEBIUS_KEY
TAVILY_API_KEY=TAVILY_KEY
# Verified on 2026-10-01. Use --engine nebius --list-models for alternatives.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Select nebius to make it the default for live collection.
CREDIBILITY_ENGINE=codex
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_TIMEOUT_SECONDS=600
NEBIUS_MAX_TOKENS=16384
NEBIUS_MAX_SEARCH_CALLS=4
