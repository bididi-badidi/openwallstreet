{
  "name": "wallstreet-leadership",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@vinext/cloudflare": "1.0.0",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "unpdf": "1.8.1",
    "vinext": "1.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.145.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts",
    "research:types": "wrangler types research/worker-configuration.d.ts --config research/wrangler.jsonc --env-interface ResearchEnv --include-runtime false",
    "research:dev": "wrangler dev --config research/wrangler.jsonc",
    "research:deploy": "wrangler deploy --config research/wrangler.jsonc",
    "research:dry-run": "wrangler deploy --dry-run --config research/wrangler.jsonc",
    "research:test": "wrangler deploy --dry-run --config research/wrangler.jsonc --outdir .wrangler/research-test && node scripts/verify-research-runtime.mjs",
    "test": "node --import tsx --test tests/*.test.*",
    "deploy:dry-run": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "schema": "tsx scripts/export-schema.ts",
    "sample:refresh": "tsx scripts/refresh-sample.ts",
    "build:preview": "CLOUDFLARE_ENV=preview vite build",
    "check": "npm run types && npm run research:types && npm run typecheck && npm test && npm run research:test && npm run build && npm run deploy:dry-run"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  }
}
