{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,128}$"
        },
        "status": {
          "type": "string",
          "const": "queued"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,128}$"
        },
        "status": {
          "type": "string",
          "const": "running"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,128}$"
        },
        "status": {
          "type": "string",
          "const": "completed"
        },
        "report": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "number",
              "const": 1
            },
            "company": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000
            },
            "deck": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000
            },
            "as_of": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            "review": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000
            },
            "source_documents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "extracted_claims": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ledger_entries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "uncurated_claims": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "claim_count_is_quality_score": {
              "type": "boolean",
              "const": false
            },
            "coverage": {
              "minItems": 1,
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "year": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "collector_excerpts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "supplemental_excerpts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  }
                },
                "required": [
                  "year",
                  "collector_excerpts",
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "collection_gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50000
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50000
              }
            },
            "assessments": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "refs": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50000
                    }
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "limit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "review_status": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "reference_roles": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50000
                      }
                    }
                  },
                  "date_support": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "entry": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50000
                        },
                        "role": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50000
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50000
                        },
                        "basis": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50000
                        }
                      },
                      "required": [
                        "entry",
                        "role",
                        "value",
                        "basis"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  }
                },
                "required": [
                  "id",
                  "refs",
                  "meaning",
                  "limit",
                  "review_status",
                  "reference_roles",
                  "date_support",
                  "name",
                  "value",
                  "summary",
                  "caption"
                ],
                "additionalProperties": false
              }
            },
            "events": {
              "minItems": 1,
              "maxItems": 250,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "refs": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50000
                    }
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "limit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "review_status": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "reference_roles": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50000
                      }
                    }
                  },
                  "date_support": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "entry": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50000
                        },
                        "role": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50000
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50000
                        },
                        "basis": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50000
                        }
                      },
                      "required": [
                        "entry",
                        "role",
                        "value",
                        "basis"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "month": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                  },
                  "date": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "date_kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "decision_by": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "tile": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "target_period": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "refs",
                  "meaning",
                  "limit",
                  "review_status",
                  "reference_roles",
                  "date_support",
                  "month",
                  "date",
                  "date_kind",
                  "type",
                  "owner",
                  "decision_by",
                  "title",
                  "summary",
                  "tile",
                  "label",
                  "target_period"
                ],
                "additionalProperties": false
              }
            },
            "evidence": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "claim_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "page": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "section": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "excerpt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "source_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "attribution": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "report_year": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "quote_verification": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "snapshot_method": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "origin": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  },
                  "source_page_text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50000
                  }
                },
                "required": [
                  "claim_id",
                  "page",
                  "section",
                  "excerpt",
                  "source_url",
                  "report_year",
                  "quote_verification",
                  "snapshot_method",
                  "origin",
                  "source_page_text"
                ],
                "additionalProperties": false
              }
            },
            "ledger_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "string",
                  "pattern": "^\\/reports\\/[a-zA-Z0-9._-]+\\.html$"
                }
              ]
            }
          },
          "required": [
            "schema_version",
            "company",
            "scope",
            "title",
            "deck",
            "as_of",
            "review",
            "source_documents",
            "extracted_claims",
            "ledger_entries",
            "uncurated_claims",
            "claim_count_is_quality_score",
            "coverage",
            "collection_gaps",
            "limitations",
            "assessments",
            "events",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "status",
        "report"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,128}$"
        },
        "status": {
          "type": "string",
          "const": "failed"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false
    }
  ]
}
