{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wallstreet-leadership",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "vars": {
    "NEBIUS_JOB_SERVICE_URL": ""
  },
  "services": [{ "binding": "RESEARCH_SERVICE", "service": "wallstreet-research" }],
  "secrets": { "required": ["NEBIUS_JOB_SERVICE_TOKEN", "RESEARCH_ACCESS_CODE"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "account_id": "2e7eb340166ebda1a90cc2ee6c589c52"
}
